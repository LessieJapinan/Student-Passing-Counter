#include <iostream>
using namespace std;

int main() {
    int grade;
    int count = 1;
    int passed = 0;
    int failed = 0;

    while (count <= 10) {
        cout << "Enter grade of student " << count << ": ";
        cin >> grade;

        if (grade >= 75) {
            passed++;
        } else {
            failed++;
        }

        count++;
    }

    cout << "\nNumber of students who passed: " << passed << endl;
    cout << "Number of students who failed: " << failed << endl;

    return 0;
}
